# Supabase project banane ke baad ye do values yahan daaliye,
# aur is file ko copy karke ".env" naam se save kijiye.
#
# Kahan milengi:
#   Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ZAROORI: "service_role" key kabhi yahan mat daaliye.
# Wo RLS ko bypass karti hai. Ye file browser me build hoti hai,
# to wo key daalte hi poora database sabke liye khul jayega.
