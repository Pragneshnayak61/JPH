{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "it-helpdesk",
  "compatibility_date": "2026-08-28",
  "observability": { "enabled": true },

  // Apna domain. `custom_domain: true` hone par wrangler DNS record aur
  // SSL certificate dono KHUD bana deta hai — dashboard me kuch nahi
  // karna padta.
  //
  // Do shartein, warna deploy yahin fail hota hai:
  //   1. helpsdesk.co.in USI Cloudflare account me "Active" ho jisme ye
  //      Worker bana hai (GitHub se jude account me).
  //   2. Us domain par pehle se koi A/AAAA/CNAME record na ho — wrangler
  //      kisi maujood record ko khud nahi hatata.
  "routes": [
    { "pattern": "helpsdesk.co.in", "custom_domain": true }
  ],

  // Ye ek static site hai — koi Worker code nahi, isliye "main" nahi hai.
  // Cloudflare sirf dist/ ki files serve karta hai.
  "assets": {
    // Ye batana ZAROORI hai. Bina iske deploy fail hoti hai:
    //   "The `assets` property in your configuration is missing the
    //    required `directory` property."
    // (Cloudflare khud jo file banata hai wo dist/ ke ANDAR hoti hai,
    //  isliye usme directory nahi likhni padti — hamari root me hai.)
    "directory": "./dist",

    // SPA routing: /login ya /admin par direct jaane par index.html
    // serve hoti hai aur Vue router aage sambhal leta hai.
    //
    // Pehle iske liye public/_redirects me "/* /index.html 200" tha,
    // par Cloudflare ne use reject kiya:
    //   "Line 3: Infinite loop detected in this rule"
    // Kyunki ye setting wahi kaam pehle se karti hai. Dono ek saath
    // nahi chal sakte — isliye _redirects hata di gayi.
    "not_found_handling": "single-page-application"
  }
}
